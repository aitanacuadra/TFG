#  .env.example — copia este archivo como .env y rellena
#  los valores marcados con <...>


# Clave para autenticar las peticiones a la API
API_KEY=<tu-api-key-secreta>


# Consigue tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<tu-clave-de-gemini>
GEMINI_MODEL=gemini-1.5-flash

# Ollama (generación de metadatos, corre en el host)
# Con Docker usa host.docker.internal; sin Docker usa localhost
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:1b
EMBEDDINGS_MODEL=nomic-embed-text

# Qdrant (base de datos vectorial)
# Con Docker el nombre del servicio es 'qdrant'; sin Docker usa localhost
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=dcat_metadata

